# CompSentry CRE Workflow Environment Configuration

# Private key for the authorized CRE reporter on Monad Testnet (or pass as PRIVATE_KEY)
DEPLOYER_PRIVATE_KEY=your_reporter_private_key_here

# Monad Testnet RPC URL
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Target SLA Contract ID to settle (optional; defaults to config.json / config.online.json)
CRE_CONTRACT=0x...

# Environment mode: 'online' (uses Google Cloud Run observers) or 'local' (uses localhost:4001-4003)
CRE_ENV=online

# Monad Deployed Contracts (optional overrides)
# HUB_ADDRESS=0x0fD55d06B382C72d8b95f5Bf9Ae1682D079B79bB
# SETTLEMENT_CONTROLLER_ADDRESS=0x8ef7455e8d01C85Af8ed9CFcc0274f4125737e2f
